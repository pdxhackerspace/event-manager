<% if @test_mode %>
<p><strong>Test mode.</strong> This message was redirected to the site test address.</p>
<% end %>
<p>Hi <%= @user.name.presence || @user.username.presence || 'there' %>,</p>
<p><%= @rsvp.display_name %> <%= @action == 'waitlisted' ? 'joined the wait list for' : (@action == 'cancelled' ? 'cancelled their RSVP for' : 'is confirmed for') %> <%= @event.title %>.</p>
<p><%= @occurrence.occurs_at.strftime('%A, %B %d, %Y at %I:%M %p') %></p>
<p><%= @counts[:confirmed] %> confirmed, <%= @counts[:waitlisted] %> waiting.</p>
<p><%= link_to 'View the list', event_occurrence_rsvps_url(@occurrence) %></p>
