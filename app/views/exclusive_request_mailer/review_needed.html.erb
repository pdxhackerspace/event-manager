<% if @test_mode %>
  <p><strong>Test mode.</strong> This email was redirected to the test address.</p>
<% end %>

<p>
  <%= @requester&.name || @requester&.email || 'A host' %> asked to reserve the space so no other event
  can be scheduled during <strong><%= @event.title %></strong>,
  including <%= @event.effective_conflict_buffer_minutes %> minutes before and after.
</p>

<p><%= link_to 'Review this request', exclusive_request_url(@event) %></p>

<% if @covered.any? %>
  <p>These events already fall inside that window:</p>
  <ul>
    <% @covered.each do |conflict| %>
      <li>
        <%= conflict.event.title %>
        (<%= conflict.occurrence.occurs_at.strftime('%b %d, %I:%M %p') %>)
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Nothing else is currently scheduled in that window.</p>
<% end %>
