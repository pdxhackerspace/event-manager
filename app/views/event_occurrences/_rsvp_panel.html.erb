<% if @occurrence.event.rsvp_enabled? && !@occurrence.rsvp_disabled? && SiteConfig.current.rsvps_enabled? %>
  <section class="card mb-3" id="rsvp">
    <div class="card-body">
      <h2 class="card-title h5">RSVP</h2>
      <% if @occurrence.effective_capacity %>
        <p class="mb-2"><%= @occurrence.spots_taken %> of <%= @occurrence.effective_capacity %> spots taken</p>
      <% end %>

      <% if @current_rsvp %>
        <p class="mb-2"><%= rsvp_status_label(@current_rsvp) %></p>
        <% if @current_rsvp.pending? %>
          <%= button_to 'Confirm RSVP', confirm_rsvp_path(@current_rsvp.manage_token), method: :post, class: 'btn btn-primary btn-sm mb-2' %>
        <% end %>
        <%= button_to 'Cancel RSVP', cancel_rsvp_path(@current_rsvp.manage_token), method: :post, class: 'btn btn-outline-danger btn-sm',
                      form: { data: { turbo_confirm: 'Cancel your RSVP?' } } %>
      <% elsif @occurrence.rsvp_open? %>
        <% if @occurrence.event.open_to == 'public' || current_user %>
          <% if current_user %>
            <%= button_to rsvp_action_label(@occurrence), occurrence_rsvp_path(@occurrence), method: :post, class: 'btn btn-primary' %>
          <% else %>
            <%= form_with url: occurrence_rsvp_path(@occurrence), method: :post, local: true do %>
              <div class="mb-2">
                <label class="form-label" for="rsvp_name">Name</label>
                <input class="form-control" type="text" name="name" id="rsvp_name" required maxlength="120">
              </div>
              <div class="mb-2">
                <label class="form-label" for="rsvp_email">Email</label>
                <input class="form-control" type="email" name="email" id="rsvp_email" required>
              </div>
              <div class="visually-hidden" aria-hidden="true">
                <label for="company_website">Company website</label>
                <input type="text" name="company_website" id="company_website" tabindex="-1" autocomplete="off">
              </div>
              <button class="btn btn-primary" type="submit"><%= rsvp_action_label(@occurrence) %></button>
            <% end %>
            <p class="form-text mt-2">Already have an account? <%= link_to 'Log in', new_user_session_path %>.</p>
          <% end %>
        <% else %>
          <%= link_to 'Log in to RSVP', new_user_session_path, class: 'btn btn-primary' %>
        <% end %>
      <% else %>
        <p class="text-muted mb-0">RSVPs are closed.</p>
      <% end %>

      <% if current_user&.admin? || (current_user && @event.hosted_by?(current_user)) %>
        <div class="mt-3">
          <%= link_to 'Manage RSVPs', event_occurrence_rsvps_path(@occurrence), class: 'btn btn-outline-secondary btn-sm' %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
