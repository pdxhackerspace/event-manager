<% occurrence = local_assigns.fetch(:occurrence, @occurrence) %>
<% event = occurrence.event %>
<% if rsvp_collecting?(occurrence) %>
  <% viewer_rsvp = if local_assigns.key?(:current_rsvp)
       local_assigns[:current_rsvp]
     else
       current_user && occurrence.rsvps.active.find_by(user: current_user)
     end %>
  <% capacity = occurrence.effective_capacity %>
  <% taken = capacity && occurrence.spots_taken %>
  <section class="card border-primary mb-4" id="rsvp">
    <div class="card-header bg-primary text-white">
      <h2 class="h5 mb-0">RSVP required</h2>
    </div>
    <div class="card-body">
      <% if local_assigns[:show_date] %>
        <p class="mb-2">
          <i class="bi bi-calendar-event" aria-hidden="true"></i>
          <%= occurrence.occurs_at.strftime('%A, %B %d, %Y at %I:%M %p') %>
        </p>
      <% end %>

      <% if capacity %>
        <% left = occurrence.spots_remaining %>
        <p class="h4 mb-1"><%= left %> of <%= capacity %> <%= 'spot'.pluralize(capacity) %> left</p>
        <p class="text-muted mb-2"><%= taken %> taken · <%= capacity %> total</p>
        <div class="progress mb-3" role="progressbar" aria-valuenow="<%= taken %>" aria-valuemin="0" aria-valuemax="<%= capacity %>" aria-label="<%= taken %> of <%= capacity %> spots taken">
          <div class="progress-bar<%= ' bg-danger' if left.zero? %>" style="width: <%= [(taken * 100.0 / capacity).round, 100].min %>%"></div>
        </div>
      <% else %>
        <p class="text-muted mb-3">No capacity limit</p>
      <% end %>

      <% if viewer_rsvp %>
        <p class="mb-2"><%= rsvp_status_label(viewer_rsvp) %></p>
        <% if viewer_rsvp.pending? %>
          <%= button_to 'Confirm RSVP', confirm_rsvp_path(viewer_rsvp.manage_token), method: :post, class: 'btn btn-primary mb-2' %>
        <% end %>
        <%= button_to 'Cancel RSVP', cancel_rsvp_path(viewer_rsvp.manage_token), method: :post, class: 'btn btn-outline-danger',
                      form: { data: { turbo_confirm: 'Cancel your RSVP?' } } %>
      <% elsif occurrence.rsvp_open? %>
        <% if event.open_to == 'public' || current_user %>
          <% if current_user %>
            <%= button_to rsvp_action_label(occurrence), occurrence_rsvp_path(occurrence), method: :post, class: 'btn btn-primary' %>
          <% else %>
            <%= form_with url: occurrence_rsvp_path(occurrence), method: :post, local: true do %>
              <div class="mb-2">
                <label class="form-label" for="rsvp_name">Name</label>
                <input class="form-control" type="text" name="name" id="rsvp_name" required maxlength="120" autocomplete="name">
              </div>
              <div class="mb-2">
                <label class="form-label" for="rsvp_email">Email</label>
                <input class="form-control" type="email" name="email" id="rsvp_email" required autocomplete="email">
              </div>
              <div class="visually-hidden" aria-hidden="true">
                <label for="company_website">Company website</label>
                <input type="text" name="company_website" id="company_website" tabindex="-1" autocomplete="off">
              </div>
              <button class="btn btn-primary" type="submit"><%= rsvp_action_label(occurrence) %></button>
            <% end %>
            <p class="form-text mt-2">Already have an account? <%= link_to 'Log in', rsvp_login_path(occurrence, on_event_page: local_assigns[:show_date]) %>.</p>
          <% end %>
        <% else %>
          <%= link_to 'Log in to RSVP', rsvp_login_path(occurrence, on_event_page: local_assigns[:show_date]), class: 'btn btn-primary' %>
        <% end %>
      <% else %>
        <p class="text-muted mb-0">RSVPs are closed.</p>
      <% end %>

      <% if current_user&.admin? || (current_user && event.hosted_by?(current_user)) %>
        <div class="mt-3">
          <%= link_to 'Manage RSVPs', event_occurrence_rsvps_path(occurrence), class: 'btn btn-outline-secondary btn-sm' %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
