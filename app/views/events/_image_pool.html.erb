<% persisted = event.persisted? %>
<% pooled_images = persisted ? event.pooled_images.includes(image_attachment: :blob).to_a : [] %>
<% selection_modes = [['Fixed image for all occurrences', 'fixed'],
                      ['Random (avoid immediate repeat)', 'random'],
                      ['Cycle through pool in order', 'cycle']] %>

<div id="image-pool" class="card mb-3">
  <div class="card-header">
    <h5 class="mb-0"><i class="bi bi-images"></i> Image Pool</h5>
  </div>
  <div class="card-body">
    <p class="text-muted">
      Upload banner images for this event. Choose how images are assigned to new occurrences,
      reorder the pool, and pick a fixed fallback image.
    </p>

    <% if persisted %>
      <div class="mb-4"
           data-controller="pending-upload"
           data-pending-upload-form-ids-value="<%= ['event-wizard-form', 'event-image-settings-form'].to_json %>"
           data-pending-upload-field-name-value="event[pool_images][]">
        <%= form_with url: event_event_images_path(event), method: :post, local: true, html: { multipart: true } do %>
          <div class="mb-3">
            <%= label_tag :images, 'Upload Images', class: 'form-label' %>
            <%= file_field_tag 'images[]', class: 'form-control', accept: 'image/*', multiple: true,
                               data: { pending_upload_target: 'input', action: 'change->pending-upload#inputChanged' } %>
            <small class="form-text text-muted">
              Recommended: 1200x400 pixels (3:1 ratio). Max 5MB per image.
            </small>
            <div class="alert alert-info py-2 mt-2 mb-0 d-none" role="status" data-pending-upload-target="notice"></div>
          </div>
          <%= submit_tag 'Add to Pool', class: 'btn btn-outline-primary' %>
        <% end %>
      </div>
    <% else %>
      <div class="mb-4">
        <%= label_tag 'event_pool_images', 'Upload Images', class: 'form-label' %>
        <%= file_field_tag 'event[pool_images][]', class: 'form-control', accept: 'image/*', multiple: true,
                           id: 'event_pool_images', form: 'event-wizard-form' %>
        <small class="form-text text-muted">
          Recommended: 1200x400 pixels (3:1 ratio). Max 5MB per image.
          These images are added to the pool when you create the event.
        </small>
      </div>
    <% end %>

    <% if persisted %>
      <%= form_with(model: event, url: event_path(event), method: :patch, local: true, multipart: true,
                    id: 'event-image-settings-form', class: 'mb-3') do |f| %>
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :image_selection_mode, 'Selection Mode', class: 'form-label' %>
            <%= f.select :image_selection_mode, selection_modes, {}, class: 'form-select' %>
            <small class="form-text text-muted">
              Applied when new occurrences are generated. Save settings, then use Reassign to update existing non-custom occurrences.
            </small>
          </div>
        </div>

        <% if pooled_images.any? %>
          <div class="mt-4">
            <h6 class="mb-3">Fixed Image</h6>
            <div class="row g-2">
              <% pooled_images.each do |event_image| %>
                <div class="col-md-4 col-lg-3">
                  <div class="form-check">
                    <%= radio_button_tag 'event[fixed_event_image_id]', event_image.id, event.fixed_event_image_id == event_image.id, class: 'form-check-input', id: "fixed_image_#{event_image.id}" %>
                    <%= label_tag "fixed_image_#{event_image.id}", class: 'form-check-label d-flex align-items-center gap-2' do %>
                      <%= event_image_thumbnail_tag event_image.image, class: 'img-thumbnail', style: 'width: 80px; height: 40px; object-fit: cover;', alt: 'Pool image' %>
                      <span>Pool image #<%= event_image.position + 1 %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="alert alert-secondary mt-3 mb-0">
            No images in the pool yet. Upload images above to get started.
          </div>
        <% end %>

        <div class="mt-4">
          <%= f.submit 'Save Image Settings', class: 'btn btn-primary' %>
        </div>
      <% end %>
    <% else %>
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= label_tag 'event_image_selection_mode', 'Selection Mode', class: 'form-label' %>
          <%= select_tag 'event[image_selection_mode]',
                         options_for_select(selection_modes, event.image_selection_mode),
                         class: 'form-select', id: 'event_image_selection_mode', form: 'event-wizard-form' %>
          <small class="form-text text-muted">
            Applied when occurrences are generated. The first image you upload becomes the fixed image;
            you can reorder the pool and change that once the event exists.
          </small>
        </div>
      </div>
    <% end %>

    <% if persisted %>
      <div class="mb-4">
        <%= button_to 'Reassign Existing Occurrences',
                      reassign_event_event_images_path(event),
                      method: :post,
                      class: 'btn btn-outline-secondary',
                      form: {
                        data: {
                          turbo_confirm: 'Reassign images for all non-custom occurrences using the saved selection mode? Occurrences with custom images are not changed.'
                        }
                      } %>
        <small class="form-text text-muted d-block mt-1">
          Uses the current saved selection mode and fixed image. Custom occurrence images are left unchanged.
        </small>
      </div>

      <% if pooled_images.any? %>
        <div data-controller="image-pool"
             data-image-pool-reorder-url-value="<%= reorder_event_event_images_path(event) %>">
          <h6 class="mb-3">Pool Images <small class="text-muted">(drag to reorder)</small></h6>
          <div class="row g-3" data-image-pool-target="list">
            <% pooled_images.each do |event_image| %>
              <div class="col-md-4 col-lg-3"
                   data-image-pool-target="item"
                   data-image-id="<%= event_image.id %>"
                   draggable="true"
                   data-action="dragstart->image-pool#dragstart dragend->image-pool#dragend dragover->image-pool#dragover">
                <div class="card h-100">
                  <% if event_image.image.attached? %>
                    <%= event_image_thumbnail_tag event_image.image, class: 'card-img-top', style: 'height: 120px; object-fit: cover;', alt: 'Pool image' %>
                  <% else %>
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 120px;">
                      <span class="text-muted">No image</span>
                    </div>
                  <% end %>
                  <div class="card-body p-2">
                    <div class="btn-group btn-group-sm w-100" role="group" aria-label="Reorder image">
                      <button type="button" class="btn btn-outline-secondary" data-action="image-pool#moveUp" aria-label="Move up">↑</button>
                      <button type="button" class="btn btn-outline-secondary" data-action="image-pool#moveDown" aria-label="Move down">↓</button>
                      <%= button_to event_event_image_path(event, event_image),
                                    method: :delete,
                                    class: 'btn btn-outline-danger',
                                    form: { data: { turbo_confirm: 'Remove this image from the pool?' } } do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% non_pooled = event.event_images.where(in_pool: false).includes(image_attachment: :blob) %>
      <% if non_pooled.any? %>
        <hr>
        <h6 class="mb-3">Occurrence-Only Images</h6>
        <p class="text-muted small">Custom images uploaded for specific occurrences. You can add them to the pool.</p>
        <div class="row g-3">
          <% non_pooled.each do |event_image| %>
            <div class="col-md-4 col-lg-3">
              <div class="card h-100">
                <%= event_image_thumbnail_tag event_image.image, class: 'card-img-top', style: 'height: 120px; object-fit: cover;', alt: 'Occurrence image' %>
                <div class="card-body p-2">
                  <%= button_to 'Add to Pool',
                                event_event_image_path(event, event_image),
                                method: :patch,
                                params: { event_image: { in_pool: true } },
                                class: 'btn btn-sm btn-outline-primary w-100' %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
